{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Родословная",
  "version": "0.1.0",
  "identifier": "com.bildbot.genedek",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Родословная",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: tauri:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: tauri: data: blob:; font-src 'self' data:; media-src 'self' asset: tauri: data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ru-RU"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
